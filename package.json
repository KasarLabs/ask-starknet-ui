{
  "name": "ask-starknet-ui",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "author": "enitrat",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:local": "LOCAL_MODE=true next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "check-types": "tsc --noEmit",
    "security:check": "pnpm audit --audit-level=high",
    "security:fix": "pnpm audit fix",
    "security:full": "./scripts/security-check.sh",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@icons-pack/react-simple-icons": "^9.4.0",
    "@langchain/core": "^0.3.79",
    "@tailwindcss/typography": "^0.5.12",
    "autoprefixer": "^10.4.22",
    "better-react-mathjax": "^2.3.0",
    "clsx": "^2.1.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.559.0",
    "markdown-to-jsx": "^7.4.5",
    "next": "15.5.7",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.304.0",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0",
    "react-katex": "^3.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-text-to-speech": "^0.19.5",
    "react-textarea-autosize": "^8.5.3",
    "sonner": "^1.4.41",
    "tailwind-merge": "^2.2.2",
    "uuid": "^11.1.0",
    "zod": "^3.22.4"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "prismjs": ">=1.30.0",
      "js-yaml": ">=4.1.1"
    }
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-katex": "^3.0.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.5.7",
    "postcss": "^8.5.3",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
